set(clear "V1 100 1 100 0 0 5 0 0 0 1 10 0 5 0 0 0 0 0")
set(stale "V1 100 1 99 0 0 5 0 0 0 1 10 0 5 0 0 0 0 0")
set(oversized "V1 100 1 100 0 0 5 0 0 0 257")
file(WRITE "${WORK_DIR}/bridge-input.txt" "${clear}\n${stale}\n${oversized}\nV1 nan\n${clear}\n")
execute_process(COMMAND "${BRIDGE}" INPUT_FILE "${WORK_DIR}/bridge-input.txt" OUTPUT_VARIABLE output RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "bridge process failed: ${result}")
endif()
string(REPLACE "\n" ";" lines "${output}")
list(FILTER lines EXCLUDE REGEX "^$")
list(LENGTH lines length)
if(NOT length EQUAL 5)
  message(FATAL_ERROR "unexpected response count: ${output}")
endif()
set(expected proceed hold hold hold proceed)
foreach(i RANGE 0 4)
  list(GET lines ${i} line)
  list(GET expected ${i} want)
  string(JSON got GET "${line}" action)
  if(NOT got STREQUAL want)
    message(FATAL_ERROR "response ${i}: expected ${want}, got ${line}")
  endif()
endforeach()
